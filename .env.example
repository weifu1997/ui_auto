# Copy this file to .env, fill in the secret, and run: chmod 600 .env
PLATFORM_SECRET_KEY=
# Direct Python startup without a key fails closed. Local-only fallback:
# AUTOFLOW_ALLOW_INSECURE_DEV_KEY=1

# Optional production overrides
AUTOFLOW_STATIC_DIRECTORY=dist
AUTOFLOW_LISTEN_HOST=127.0.0.1
PORT=8787
