# Copy this file to .env, fill in the secret, and run: chmod 600 .env
PLATFORM_SECRET_KEY=
# Direct Python startup without a key fails closed. Local-only fallback:
# AUTOFLOW_ALLOW_INSECURE_DEV_KEY=1

# Master-key versioning (rotation, optional; single-key v1 deployment if unset).
# The active secret (above) is version PLATFORM_SECRET_KEY_VERSION; other
# versions map to their older keys here, for decrypt-only dual-read during
# rotation. See docs/密钥托管与恢复.md 「主密钥轮换」 for the full procedure.
# PLATFORM_SECRET_KEY_VERSION=1
# PLATFORM_SECRET_KEY_VERSIONS={"1":"<older key>"}

# Optional production overrides
AUTOFLOW_STATIC_DIRECTORY=dist
AUTOFLOW_LISTEN_HOST=127.0.0.1
PORT=8787
# AUTOFLOW_CORS_ORIGINS=
