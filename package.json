{
  "name": "ui_auto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup:py": "node scripts/setup-py.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "server:py": "node scripts/server-py.mjs",
    "test:py": "node scripts/run-py.mjs -m pytest server-py/tests",
    "server": "npm run server:py",
    "start": "npm run server:py",
    "test:all": "npm run build && npm run lint && npm run test:unit && npm run test:py && npm run test:e2e && npm run test:windows",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-scripts-smoke.ps1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
